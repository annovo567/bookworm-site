RewriteEngine On
RewriteBase /

RewriteRule ^api/v1/ip/?$ index.php [L,QSA]
RewriteRule ^api/v1/public/ index.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]

